SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: habilita la Carga rápida por IA en Movimientos. Sin esta clave,
# ese botón sigue apareciendo pero avisa que todavía no está configurada
# (nunca rompe el resto de la app). Nunca con prefijo VITE_ — nunca debe
# llegar al navegador.
ANTHROPIC_API_KEY=

# Notificaciones de vencimientos próximos (cron diario, ver vercel.json y
# src/lib/notifications.functions.ts). Cada una es opcional por separado:
# sin RESEND_API_KEY no se manda email, sin las VAPID_* no se manda push,
# sin CRON_SECRET el endpoint rechaza cualquier llamada.
#
# - CRON_SECRET: protege /cron-notificaciones. Vercel lo agrega solo como
#   header "Authorization: Bearer <CRON_SECRET>" en cada invocación del cron
#   SI esta env var está configurada en el proyecto de Vercel.
# - RESEND_API_KEY: cuenta en https://resend.com (capa gratis alcanza).
# - VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: par de claves para Web Push,
#   generado con `npx web-push generate-vapid-keys` (no requiere cuenta).
#   VITE_VAPID_PUBLIC_KEY debe tener el MISMO valor que VAPID_PUBLIC_KEY
#   (la pública sí puede viajar al navegador, la privada nunca).
# - EMAIL_FROM: remitente del mail. Sin configurar, usa el sandbox de Resend
#   (onboarding@resend.dev) — anda pero llega marcado como "vía resend.dev".
CRON_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Pagos web (Lemon Squeezy), ver src/routes/webhooks/lemonsqueezy.ts y
# src/components/app/paywall-screen.tsx.
# - VITE_LEMONSQUEEZY_CHECKOUT_URL: el link de checkout del producto
#   ("Platium — Acceso completo"), tal cual lo copiás desde el dashboard de
#   Lemon Squeezy (botón "Share" → "Copy URL" en la página del producto).
#   Es público a propósito (VITE_): solo es un link de compra, no un secret.
# - LEMONSQUEEZY_WEBHOOK_SECRET: el "Signing secret" que Lemon Squeezy genera
#   al crear el webhook (Settings → Webhooks → nuevo webhook apuntando a
#   https://platium.app/webhooks/lemonsqueezy, eventos order_created y
#   order_refunded). Sin esta env var el webhook rechaza todo (nunca marca
#   un pago sin poder verificar que vino realmente de Lemon Squeezy).
VITE_LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Pagos nativos (RevenueCat, iOS/Android), ver src/lib/revenuecat-native.ts
# y src/routes/webhooks/revenuecat.ts. Solo tiene efecto adentro de la app
# empaquetada con Capacitor — en la web sigue usándose Lemon Squeezy.
# - VITE_REVENUECAT_IOS_API_KEY: la "Public app-specific API key" del
#   proyecto de iOS en el dashboard de RevenueCat (Project settings → API
#   keys). Pública a propósito, es la misma que usa cualquier app nativa.
# - REVENUECAT_WEBHOOK_SECRET: el valor completo del header Authorization
#   que vos mismo definís al crear el webhook en RevenueCat (Project
#   settings → Webhooks), ej. "Bearer un-secret-bien-largo-inventado-por-vos".
#   Tiene que ser IDÉNTICO acá y en RevenueCat.
VITE_REVENUECAT_IOS_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
